<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Datamodel</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>KeyValues2</PackageId>
    <Version>2.0-rc2</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <Authors>Tom Edwards, ValveResourceFormat contributors</Authors>
    <Copyright>Copyright (c) 2013 Tom Edwards and ValveResourceFormat contributors</Copyright>
    <Description>Implements Valve's Datamodel Exchange (DMX) file format.</Description>
    <PackageProjectUrl>https://github.com/ValveResourceFormat/Datamodel.NET</PackageProjectUrl>
    <PackageTags>valve;dmx;datamodel;keyvalues2;source-engine;vmap</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsAotCompatible>true</IsAotCompatible>
    <AnalysisMode>All</AnalysisMode>
    <NoWarn>CA1003;CA1032;CA1033;CA1034;CA1043;CA1051;CA1062;CA1707;CA1710;CA1724;CA1819;CA1852;CA2225;CA2227</NoWarn>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>sgKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\Misc\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- the source generator runs on this project and ships inside this package, so consumers get it with the library -->
    <ProjectReference Include="..\ElementFactoryGenerator\ElementFactoryGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <None Include="..\ElementFactoryGenerator\bin\$(Configuration)\netstandard2.0\ElementFactoryGenerator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
